generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  cancelled
  completed
  returned
}


model Product {
  id String @id @default(uuid())
  title String
  description String
  price Decimal
  items OrderItem[]
}


model Order {
  id String @id @default(uuid())
  externalId String? @unique
  userId String
  total Decimal
  status OrderStatus
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  transactionId String @unique
  items OrderItem[]
}

model OrderItem {
 id String @id @default(uuid())
 orderId String
 productId String
 quantity Int
 price Decimal

 order Order @relation(fields: [orderId], references: [id])
 product Product @relation(fields: [productId], references: [id])
}